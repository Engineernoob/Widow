# ==========================================
# 🦀 Widow v0.2 — Intelligence Layer
# Builds widow-worker and runs it inside a minimal container
# Connects to external Qdrant (via localhost:6334)
# ==========================================

# ---------- Stage 1: Build ----------
FROM rust:1.82-slim-bookworm AS builder

WORKDIR /app

# Copy manifest and source
COPY Cargo.toml ./
COPY crates ./crates

# Build only the worker crate (release build)
RUN cargo build --release -p widow-worker

# ---------- Stage 2: Runtime ----------
FROM debian:bookworm-slim

# Install CA certs + minimal dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates libssl3 curl && \
  rm -rf /var/lib/apt/lists/*

# Copy the widow binary from the builder stage
COPY --from=builder /app/target/release/widow-worker /usr/local/bin/widow-worker

# Create a working directory for crawl data
WORKDIR /data

# Expose ports (if you later serve APIs)
EXPOSE 8080

# Default environment
ENV QDRANT_URL=http://host.docker.internal:6334 \
  RUST_LOG=info \
  WIDOW_MODE=worker

# Run Widow
CMD ["/usr/local/bin/widow-worker"]
