# ==========================================
# 🦀 Widow v0.2 — Intelligence Layer
# Builds widow-worker and connects to Qdrant
# ==========================================

# ---------- Stage 1: Build ----------
FROM rust:1.82-slim-bookworm AS builder

WORKDIR /app

# --- Install build dependencies for OpenSSL ---
RUN apt-get update && apt-get install -y --no-install-recommends \
  pkg-config \
  libssl-dev \
  build-essential \
  ca-certificates \
  curl && \
  rm -rf /var/lib/apt/lists/*

# Copy manifest and source
COPY Cargo.toml ./
COPY crates ./crates

# Build release binary for widow-worker
RUN cargo build --release -p widow-worker

# ---------- Stage 2: Runtime ----------
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates libssl3 curl && \
  rm -rf /var/lib/apt/lists/*

WORKDIR /data

# Copy the compiled binary
COPY --from=builder /app/target/release/widow-worker /usr/local/bin/widow-worker

ENV QDRANT_URL=http://qdrant:6334 \
  RUST_LOG=info

CMD ["/usr/local/bin/widow-worker"]
